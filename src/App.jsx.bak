import React, { useState, useEffect, useMemo } from "react";
import { Eye, EyeOff, LogOut, ArrowLeft, ArrowRight, X, Trash2, CheckCircle2, Ticket, History, Landmark, Zap, ShieldCheck, Settings, Plus, Edit3, Check, RefreshCw } from "lucide-react";
import { mergeGamesWithAdminOverrides, fetchLiveGamesFromAPI } from "./apiService";
import { supabase } from "./supabaseClient";


// ---------- Sport icon glyphs (custom, no trademarked logos) ----------
function GloveIcon({ className }) {
  return (
    <svg viewBox="0 0 64 64" className={className} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="ufcGlow" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stopColor="#FF416C" />
          <stop offset="100%" stopColor="#FF4B2B" />
        </linearGradient>
      </defs>
      <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#ufcGlow)" fillOpacity="0.1" stroke="url(#ufcGlow)" strokeWidth="1.5" />
      <path
        d="M20 36V22c0-2.2 1.8-4 4-4s4 1.8 4 4v10M28 32V20c0-2.2 1.8-4 4-4s4 1.8 4 4v8M36 32V22c0-2.2 1.8-4 4-4s4 1.8 4 4v10M44 34v-8c0-2.2 1.8-4 4-4s4 1.8 4 4v16c0 6.6-5.4 12-12 12H30c-5.5 0-10-4.5-10-10v-4"
        stroke="url(#ufcGlow)"
        strokeWidth="3.2"
        strokeLinecap="round"
        strokeLinejoin="round"
      />
      <rect x="24" y="44" width="16" height="6" rx="2" fill="url(#ufcGlow)" />
    </svg>
  );
}

function BaseballIcon({ className }) {
  return (
    <svg viewBox="0 0 64 64" className={className} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="baseballGlow" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stopColor="#E8C34A" />
          <stop offset="100%" stopColor="#C9A227" />
        </linearGradient>
      </defs>
      <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#baseballGlow)" fillOpacity="0.1" stroke="url(#baseballGlow)" strokeWidth="1.5" />
      <circle cx="32" cy="32" r="18" stroke="url(#baseballGlow)" strokeWidth="3.2" />
      <path
        d="M20 20c4.5 4.5 4.5 19.5 0 24M44 20c-4.5 4.5-4.5 19.5 0 24"
        stroke="#FF4B2B"
        strokeWidth="2"
        strokeLinecap="round"
        strokeDasharray="2 3"
      />
    </svg>
  );
}

function BallIcon({ className }) {
  return (
    <svg viewBox="0 0 64 64" className={className} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="futbolGlow" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stopColor="#2D97F7" />
          <stop offset="100%" stopColor="#0667C2" />
        </linearGradient>
      </defs>
      <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#futbolGlow)" fillOpacity="0.1" stroke="url(#futbolGlow)" strokeWidth="1.5" />
      <circle cx="32" cy="32" r="18" stroke="url(#futbolGlow)" strokeWidth="3.2" />
      <path
        d="M32 22l5.5 4-2 6.5h-7l-2-6.5 5.5-4zM32 22v-8M37.5 26l6.5-2M26.5 26l-6.5-2M28.5 32.5L24 38.5M35.5 32.5l4.5 6M24 38.5h16"
        stroke="url(#futbolGlow)"
        strokeWidth="2.2"
        strokeLinecap="round"
        strokeLinejoin="round"
      />
    </svg>
  );
}

function BasketballIcon({ className }) {
  return (
    <svg viewBox="0 0 64 64" className={className} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="nbaGlow" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stopColor="#FF7B00" />
          <stop offset="100%" stopColor="#FFA600" />
        </linearGradient>
      </defs>
      <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#nbaGlow)" fillOpacity="0.1" stroke="url(#nbaGlow)" strokeWidth="1.5" />
      <circle cx="32" cy="32" r="18" stroke="url(#nbaGlow)" strokeWidth="3.2" />
      <path
        d="M32 14v36M14 32h36M20 20c5.5 5.5 5.5 18.5 0 24M44 20c-5.5 5.5-5.5 18.5 0 24"
        stroke="url(#nbaGlow)"
        strokeWidth="2.2"
        strokeLinecap="round"
      />
    </svg>
  );
}

